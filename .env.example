# =============================================================================
# Parallax secrets — EXAMPLE
# =============================================================================
# Copy to .env (gitignored) and fill in. NEVER commit the real .env.
# Only .env.example is tracked. Keep non-secret config in
# config/settings.yaml instead.
#
# HOW THESE ARE READ: from the process environment, NOT from this file. Nothing
# in the codebase loads a .env — this file documents which keys exist and gives
# you somewhere to keep them. To actually use one, export it in your shell:
#
#     export ANTHROPIC_API_KEY=sk-ant-...
#
# and set it inside the crontab for scheduled runs, since cron does not inherit
# your shell environment. `python -m scoring.liberty` verifies the Claude path
# end to end for a fraction of a cent.
# =============================================================================

# --- LLM (Claude) ----------------------------------------------------------
# Used for summarization, steelmanning, liberty/oppression tagging, and
# adjudicating tagger disagreements.
ANTHROPIC_API_KEY=

# --- Hugging Face (optional) ----------------------------------------------
# Only affects downloads of the Mformer transformer models. Everything works
# without it; unauthenticated requests just get lower Hub rate limits, a slower
# first download (Mformer is five RoBERTa models, a couple of GB), and this
# warning on every run:
#
#     You are sending unauthenticated requests to the HF Hub. Please set a
#     HF_TOKEN to enable higher rate limits and faster downloads.
#
# A read-only token from https://huggingface.co/settings/tokens silences it.
HF_TOKEN=

# --- Subscriber feeds -------------------------------------------------------
# Feeds whose URL is itself the credential: a per-account token in the path or
# query, handed out with a subscription and not to be shared. A source in
# config/sources.yaml names the variable (`url_env:`); the value lives here, so
# the registry stays public and the token does not.
#
# Unset is a supported state — the source falls back to its public `url` and the
# run continues, which for a partial feed means a truncated transcript rather
# than none.
#
# Making Sense (Sam Harris): samharris.org account -> Private Podcast Feed.
PARALLAX_FEED_MAKINGSENSE=

# --- Corpus / discovery APIs ----------------------------------------------
# Media Cloud: corpus construction and attention validation. `pip install mediacloud`
MEDIACLOUD_API_KEY=
# GDELT DOC 2.0 needs no key; left here for documentation only.

# --- Daily email brief -----------------------------------------------------
# The dashboard, rendered into an email. All four of HOST/USER/PASSWORD/TO must
# be set or the digest declines to send and says so — a half-configured mailer
# is exactly the thing that fails at 6am on a machine nobody is watching.
#
# For Gmail this must be an app password, not your account password (with 2FA
# on, Google rejects the account password outright). Most providers also require
# FROM to match USER, and silently drop the message when it doesn't.
#
# Preview the rendering with no credentials at all:
#     python -m digest --dry-run --open
PARALLAX_SMTP_HOST=
PARALLAX_SMTP_PORT=587
PARALLAX_SMTP_USER=
PARALLAX_SMTP_PASSWORD=
PARALLAX_DIGEST_TO=
# PARALLAX_DIGEST_FROM=        # defaults to PARALLAX_SMTP_USER
#
# TLS certificates are verified (chain and hostname). If verification fails the
# digest refuses to send and says so, rather than handing your password to
# whoever presented the certificate — that failure looks the same whether the
# server is misconfigured or the connection is being intercepted, so fix the
# server rather than working around the check.
# Port 465 is used as implicit TLS automatically; 587 upgrades via STARTTLS.
# PARALLAX_SMTP_STARTTLS=1     # 0 only for a relay on this machine. Turning it
#                              # off for a remote host is refused outright: the
#                              # password would cross the network in the clear.

# --- Datastore (only when datastore.kind = postgres) -----------------------
# PARALLAX_POSTGRES_DSN=postgresql://user:password@localhost:5432/parallax
